<% layout("layouts/boilerplate") %>
<div class="row">
  <div class="col-6 offset-3">
    <h3>Listing:</h3>
    <div class="card card-listing">
      <div class="col-10">
        <img
          src="<%= listing.image.url %>"
          class="card-img main-img"
          alt="listing-image"
        />
      </div>
      <div class="card-body">
        <h5 class="card-title"><b><%= listing.title %></b></h5>
        <p class="card-text content">
          <b>Owned By:</b> <i><%= listing.owner.username %></i>
        </p>
        <p class="card-text content">
          <b>Description:</b> <%= listing.description %>
        </p>
        <b
          ><p class="card-text content-1">
            Price: &#8360; <%= listing.price.toLocaleString('en-PK') %>/Night
          </p></b
        >
        <p class="card-text content"><b>Country:</b> <%= listing.country %></p>
        <p class="card-text content">
          <b>Location:</b> <%= listing.location %>
        </p>
      </div>
    </div>
    <!-- <% if(currUser && currUser._id.equals(listing.owner._id)) { %> -->
    <div class="btns">
      <a
        href="/listings/<%= listing._id %>/edit"
        class="col-2 btn btn-dark edit-btn"
        >Edit</a
      >
      <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-3">Delete</button>
      </form>
    </div>
    <!-- <% } %> -->
    <hr>
    <% if(currUser) { %>
    <div>
      <h4>Leave a Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div>
            <label for="rating" class="form-label">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
          </fieldset>
        </div>
        
        <div>
          <label for="comment" class="form-label">Comment</label>
          <textarea
            name="review[comment]"
            id="comment"
            class="form-control"
            rows="5"
            required
          ></textarea>
          <div class="invalid-feedback">Please leave a review</div>
        </div>
        <button class="btn btn-outline-dark mt-3">Submit</button>
      </form>
      <hr>
      <div>
        <% } %>
        <p><b>All Reviews</b></p>
        <div class="row">
          <% for(review of listing.reviews){ %>
            <div class="card mt-3 p-2 ms-3 col-5">
              <div class="card-body">
                <h5 class="card-title">@<%= review.author.username %></h5>
                <p class="card-text"><%= review.comment %></p>
                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                <form action="/listings/<%= listing.id %>/reviews/<%= review._id%>?_method=DELETE" method="POST" class="mb-2">
                  <button class="btn btn-small btn-dark">Delete</button>
                </form>
              </div>
            </div>
          <% } %>
          </div>
      </div>
    </div>
  </div>
</div>
<% layout("layouts/boilerplate") %>
<div class="row">
  <div class="col-6 offset-3">
    <h3>Edit Your Listing</h3>
    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=PUT"
      enctype="multipart/form-data"
    >
      <label for="title" class="form-label">Enter Your Title</label>
      <input
        type="text"
        name="listing[title]"
        class="form-control"
        value="<%= listing.title %>"
        placeholder="enter your title"
      />
      <label for="description" class="form-label">Enter Your Title</label>
      <textarea name="listing[description]" class="form-control">
        <%= listing.description %></textarea
      >

      <div class="mt-3">
        Orignal Image <br />
        <img src="<%= orignalImageUrl %>" />
      </div>
      <label for="image" class="form-label">Upload Your Image</label>
      <input type="file" name="listing[image]" class="form-control" />

      <div class="row">
        <div class="col-4">
          <label for="price" class="form-label">Enter Your Price</label>
          <input
            type="number"
            name="listing[price]"
            class="form-control"
            value="<%= listing.price %>"
            placeholder="enter your price"
          />
        </div>
        <div class="col-8">
          <label for="country" class="form-label">Enter Your country</label>
          <input
            type="text"
            name="listing[country]"
            class="form-control"
            value="<%= listing.country %>"
            placeholder="enter country"
          />
        </div>
      </div>
      <label for="location" class="form-label">Enter Your location</label>
      <input
        type="text"
        name="listing[location]"
        class="form-control"
        value="<%= listing.location %>"
        placeholder="enter location"
      />
      <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </form>
  </div>
</div>
